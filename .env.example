# Copy to `.env` (Prisma) and `.env.local` (Next.js also reads `.env`).
# Do not commit real keys.

# PostgreSQL connection string. Required for the library, posters, and saved narration.
DATABASE_URL=postgresql://audiobook:audiobook@127.0.0.1:5432/audiobook

# Story text (OpenAI Responses API).
OPENAI_API_KEY=
OPENAI_STORY_MODELS=gpt-4o-mini
OPENAI_STORY_TEMPERATURE=0.92
OPENAI_STORY_TIMEOUT_MS=180000

# Poster image. POSTER_IMAGE_PROVIDER=auto uses OpenAI when OPENAI_API_KEY is set, otherwise Gemini.
POSTER_IMAGE_PROVIDER=auto
# gpt-image-1, gpt-image-1-mini, and gpt-image-1.5 use portrait size 1024x1536.
# dall-e-3 still works if you set it here (size 1024x1792). A retired DALL·E model retries gpt-image-1.5 once.
OPENAI_POSTER_IMAGE_MODEL=gpt-image-1.5
# gpt-image: low | medium | high | auto. dall-e-3: standard | hd (hd maps to high on gpt-image).
OPENAI_POSTER_IMAGE_QUALITY=medium
OPENAI_POSTER_TIMEOUT_MS=180000
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=imagen-4.0-fast-generate-001
GEMINI_HTTP_TIMEOUT_MS=300000

# Narration. Built-in voices are in lib/voices/voices.ts. ELEVENLABS_VOICE_ID is only a fallback.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_v3
# Automatic retries are off. Turn them on only after an explicit spend approval:
#   NARRATION_RETRY_APPROVED=1
#   NARRATION_RETRY_BUDGET_USD=0.50
# A live narration benchmark also stays off unless both of these are set, and the cap
# must cover the printed estimate. Do not set them in production without that approval.
#   RUN_LIVE_NARRATION=1
#   LIVE_NARRATION_MAX_USD=0.35

# Daily catalog cron. Required for /api/cron/daily-stories.
CRON_SECRET=

# Parent email sign-in is paused. The routes, session cookie, and sign-in screen stay in the app.
# Leave AUTH_ENABLED unset or false: no sign-in screen, and every story is saved on one built-in
# user (guest@local.invalid), created the first time the app talks to the database.
# To turn login back on, set all of these, then restart `next dev` or redeploy on Vercel:
#   AUTH_ENABLED=true
#   RESEND_API_KEY
#   AUTH_EMAIL_FROM
#   AUTH_SECRET (required on Vercel)
# The first parent account that signs in, if it has no library yet, receives the guest library.
# Those rows are reassigned, not deleted. A later account does not receive them.
AUTH_ENABLED=false
# AUTH_SECRET peppers one-time codes. Use a long random string. Required on Vercel when login is on.
AUTH_SECRET=
# Resend API key (https://resend.com). When it is unset, `next dev` prints the code in the server console.
# If it is unset on Vercel (preview or production) or under `next start`, sign-in returns an error and does not log the code.
RESEND_API_KEY=
# Verified From address. Resend's sandbox sender only delivers to the address on the Resend account.
AUTH_EMAIL_FROM=Happy Horse <onboarding@resend.dev>

# Set to 0 to skip saved-story excerpts in the story prompt.
STORY_LIBRARY_ANTIREPEAT=

# Vercel Blob for posters, narration, and voice samples.
# Create a Blob store: Vercel project → Storage → Blob → Create (public access),
# then connect it to this project. Vercel writes BLOB_READ_WRITE_TOKEN for Production,
# Preview, and Development. Pull it locally with `vercel env pull`.
# When this is unset, files are written to uploads/ and served by /api/posters, /api/audio, and /api/voice-sample.
BLOB_READ_WRITE_TOKEN=

# Local testing only. Never set these on Vercel production (production ignores them).
# MOCK_PROVIDERS=1 returns a canned story, MP3, and poster PNG without provider keys.
# MOCK_POSTER_MODE=fallback makes poster generation fail so the app shows simple genre artwork.
MOCK_PROVIDERS=
MOCK_POSTER_MODE=
