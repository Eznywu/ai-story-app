generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Story {
  id        String   @id @default(cuid())
  title     String
  genre     String
  length    String
  text      String
  age       String?
  language  String?
  mainCharacterName String?
  childGender String?
  posterFilename String?
  createdAt DateTime @default(now())
}

model Voice {
  id          String   @id @default(cuid())
  displayName String
  provider    String   @default("elevenlabs")
  voiceId     String
  createdAt   DateTime @default(now())
}