generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A parent account. One email is one family library.
model User {
  id            String           @id @default(cuid())
  email         String           @unique
  createdAt     DateTime         @default(now())
  sessions      Session[]
  stories       Story[]
  voices        Voice[]
  voicePreference VoicePreference?
  kids          KidProfile[]
  characters    StoryCharacter[]
  readingStats  ReadingStats?
}

/// Opaque session token is stored only as a hash. The cookie lasts about 400 days.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Email one-time code. `codeHash` is scrypt; the plaintext code is never stored.
model LoginCode {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

model Story {
  id        String   @id @default(cuid())
  /// Null means the row has no family (legacy library or the daily cron). Those rows stay in the database and are hidden from every account.
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  genre     String
  length    String
  text      String
  age       String?
  language  String?
  mainCharacterName String?
  childGender String?
  posterFilename String?
  /** Playback URL: a Vercel Blob URL, or `/api/posters/…` when Blob is not configured. */
  posterUrl String?
  /** ElevenLabs (or mock) MP3 filename. Local disk only; Blob rows still keep this key for lookup. */
  audioFilename  String?
  /** Playback URL: a Vercel Blob URL, or `/api/audio/…` when Blob is not configured. */
  audioUrl String?
  /** Narration identity. Null on rows saved before this was recorded. */
  audioModelId           String?
  audioVoiceId           String?
  audioVoiceSettings     Json?
  audioLanguage          String?
  audioDictionaryVersion String?
  audioConfigVersion     String?
  audioConfigId          String?
  audioCacheKey          String?
  /** True when this recording must not use a public Blob URL. */
  audioPrivate           Boolean  @default(false)
  /** Server-only location for a private recording. Never send this to the browser. */
  audioStorageUrl        String?
  audioVoiceKind         String?
  audioVoiceVersion      Int?
  /** True when created by the daily cron (`lib/stories/dailyAutomatedStories.ts`). */
  dailyAutomated Boolean  @default(false)
  /** Frozen character at save time. Later profile edits do not change this story's art. */
  characterId        String?
  characterSnapshot  Json?
  visualBrief        Json?
  illustrationFilename String?
  illustrationUrl      String?
  coverFilename        String?
  coverUrl             String?
  /** illustrated, fallback, error, or pending. Null until the first artwork request. */
  artworkStatus    String?
  artworkCacheKey  String?
  posterCaption    String?
  dedication       String?
  artworkMeta      Json?
  createdAt DateTime @default(now())
  narrationAssets NarrationAsset[]

  @@index([userId, createdAt])
  @@index([artworkCacheKey])
}

/// One illustration job. cacheKey is unique so two servers cannot start the same paid image.
model ArtworkJob {
  id               String    @id @default(cuid())
  cacheKey         String    @unique
  scopeKey         String
  storyId          String
  status           String
  provider         String?
  model            String?
  quality          String?
  attemptCount     Int       @default(0)
  estimatedCostUsd Float     @default(0)
  leaseUntil       DateTime?
  blockedUntil     DateTime?
  errorMessage     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([scopeKey, createdAt])
  @@index([storyId])
}

/// Daily artwork allowance. Guest browsers do not share a bucket just because they share a user id.
model ArtworkSpendDay {
  id           String @id @default(cuid())
  scopeKey     String
  dayKey       String
  generations  Int    @default(0)
  estimatedUsd Float  @default(0)

  @@unique([scopeKey, dayKey])
}

model Voice {
  id                   String    @id @default(cuid())
  userId               String?
  user                 User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName          String
  provider             String    @default("elevenlabs")
  /// Provider voice id. Never returned to the browser and never accepted from it.
  voiceId              String
  /// Recorded language of this voice. New rows store the recording locale, not a collapsed story language.
  language             String    @default("en")
  /// Locale of the script the parent actually read. Distinct from story narration language.
  recordingLocale      String?
  /// Registry version frozen when the take started.
  scriptVersion        String?
  status               String    @default("ready")
  voiceVersion         Int       @default(1)
  requiresVerification Boolean   @default(false)
  consentAt            DateTime?
  consentTextVersion   String?
  idempotencyKey       String?
  sampleFilename       String?
  /// Private storage URL. Not a public Blob URL.
  sampleStorageUrl     String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([userId, voiceId])
  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([status])
}

/// One clone attempt, used for the hourly rate limit.
model VoiceAttempt {
  id        String   @id @default(cuid())
  userId    String
  kind      String   @default("clone")
  createdAt DateTime @default(now())

  @@index([userId, kind, createdAt])
}

/// Retryable delete of a provider clone and its sample after a failed save or delete.
model VoiceCleanup {
  id               String   @id @default(cuid())
  userId           String
  providerVoiceId  String
  sampleFilename   String?
  sampleStorageUrl String?
  voiceRowId       String?
  status           String   @default("pending")
  attempts         Int      @default(0)
  lastError        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status, createdAt])
}

/// Remembered narrator and language for a signed-in account. Not an ownership record.
model VoicePreference {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  voiceAppId String
  language   String
  updatedAt  DateTime @updatedAt
}

/// One cached preview. Replay reads this row and does not call a paid voice API.
model NarrationPreview {
  id           String   @id @default(cuid())
  cacheKey     String   @unique
  voiceAppId   String
  ownerUserId  String?
  language     String
  modelId      String
  voiceVersion Int      @default(1)
  source       String
  filename     String?
  storageUrl   String?
  createdAt    DateTime @default(now())

  @@index([ownerUserId, voiceAppId])
}

model KidProfile {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  age            String
  gender         String
  interests      String[] @default([])
  personality    String?
  readingLevel   String?
  favoriteThemes String?
  bedtimeLength  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

model StoryCharacter {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  ageRange      String   @default("")
  gender        String   @default("")
  characterType String   @default("")
  personality   String   @default("")
  skills        String   @default("")
  themes        String[] @default([])
  visualStyle   String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

/// One generated narration section. Older stories have no rows here.
model NarrationAsset {
  id                String   @id @default(cuid())
  storyId           String?
  story             Story?   @relation(fields: [storyId], references: [id], onDelete: Cascade)
  sectionIndex      Int      @default(0)
  sectionCount      Int      @default(1)
  /// active, or failed when a check stopped the save
  status            String   @default("active")
  modelId           String
  voiceId           String
  voiceSettings     Json
  language          String
  dictionaryVersion String
  configVersion     String
  configId          String
  cacheKey          String
  narrationScript   String
  filename          String?
  url               String?
  durationMs        Int?
  validityStatus    String   @default("unchecked")
  validityNotes     String?
  /// matched, mismatch, uncertain, unchecked, skipped_budget, or mock
  transcriptStatus  String   @default("unchecked")
  transcriptNotes   String?
  attempt           Int      @default(1)
  baselineFlag      Boolean  @default(false)
  /// story, benchmark, or weekly
  source            String   @default("story")
  /// default, personal, or legacy. Null on rows saved before this was recorded.
  voiceKind         String?
  voiceVersion      Int?
  ownerUserId       String?
  createdAt         DateTime @default(now())

  @@index([storyId, createdAt])
  @@index([cacheKey])
  @@index([createdAt])
  @@index([baselineFlag])
}

/// A listening flag, a reported mispronunciation, or a baseline reminder.
model NarrationReviewItem {
  id          String   @id @default(cuid())
  assetId     String?
  source      String
  word        String?
  timestampMs Int?
  category    String?
  /// pending until a person has listened
  status      String   @default("pending")
  notes       String?
  payload     Json?
  createdAt   DateTime @default(now())

  @@index([status, createdAt])
  @@index([source])
}

/// One Monday review. The job writes this. It does not create audio.
model NarrationReviewReport {
  id        String   @id @default(cuid())
  weekKey   String
  status    String
  summary   Json
  createdAt DateTime @default(now())

  @@index([weekKey])
}

model ReadingStats {
  userId           String   @id
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  todayKey         String
  storiesReadToday Int      @default(0)
  streakDays       Int      @default(0)
  lastReadDayKey   String?
  lastStoryId      String?
  lastStoryTitle   String?
  draftSummary     String?
  updatedAt        DateTime @updatedAt
}
